      .cbt-sticky-cta { flex-direction: column; text-align: center; gap: 12px; padding: 12px 16px; }
      .cbt-hero-img img { max-width: 260px; }
      .cbt-stat-grid { grid-template-columns: 1fr 1fr; }
    }

    /* ── OFFER SECTION ── */
    .cbt-offer-section {
      background: linear-gradient(160deg, #f0fdfa 0%, #ffffff 60%, #faf5ff 100%);
      padding: 90px 24px;
      border-top: 1px solid var(--border-soft);
    }
    .cbt-offer-intro {
      text-align: center; max-width: 680px; margin: 0 auto 52px;
    }
    .cbt-offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 24px;
    }
    .cbt-offer-card {
      background: #fff;
      border: 1.5px solid var(--border-soft);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
      display: flex; flex-direction: column;
      transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), box-shadow 0.3s;
      position: relative;
    }
    .cbt-offer-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, var(--accent2), var(--brand));
    }
    .cbt-offer-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }
    .cbt-offer-img-wrap {
      width: 100%; aspect-ratio: 3/4; overflow: hidden;
      background: linear-gradient(135deg, #f0fdfa, #ede9fe);
      display: flex; align-items: center; justify-content: center;
    }
    .cbt-offer-img-wrap img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.4s ease;
    }
    .cbt-offer-card:hover .cbt-offer-img-wrap img { transform: scale(1.04); }
    .cbt-offer-img-placeholder {
      font-size: 3.5rem; color: var(--brand); opacity: 0.4;
    }
    .cbt-offer-body {
      padding: 22px 20px; flex: 1; display: flex; flex-direction: column; gap: 8px;
    }
    .cbt-offer-tag {
