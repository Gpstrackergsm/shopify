      <div class="cbt-sticky-name">The CBT Flip Chart + 8 Book Bundle</div>
      <div class="cbt-sticky-sub">All Included &middot; &#9733;&#9733;&#9733;&#9733;&#9733; 4.6</div>
    </div>
    <button type="button" class="cbt-btn-primary cbt-bundle-btn" style="padding:13px 30px; font-size:0.95rem;"
      data-ids="{{ cbt_variant.id }},{{ book1.variants.first.id }},{{ book2.variants.first.id }},{{ book3.variants.first.id }},{{ book4.variants.first.id }},{{ book5.variants.first.id }},{{ book6.variants.first.id }},{{ book7.variants.first.id }},{{ book8.variants.first.id }}">
      &#128722; Buy Now &mdash; {{ cbt_product.price | money }}
    </button>
  </div>

  <script>
    // Universal Bundle Add-to-Cart for all .cbt-bundle-btn buttons
    (function() {
      var bundleButtons = document.querySelectorAll('.cbt-bundle-btn');
      bundleButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var ids = (btn.getAttribute('data-ids') || '').split(',').filter(Boolean);
          if (!ids.length) return;
          var items = ids.map(function(id) { return { id: parseInt(id, 10), quantity: 1 }; });
          
          bundleButtons.forEach(function(b) {
            b.disabled = true;
            b.setAttribute('data-original-text', b.innerHTML);
            b.textContent = 'Adding to cart\u2026';
          });

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: items })
          })
          .then(function(r) { return r.json(); })
          .then(function() {
            window.location.href = '/checkout';
          })
          .catch(function(err) {
            console.error(err);
            bundleButtons.forEach(function(b) {
              b.disabled = false;
              var orig = b.getAttribute('data-original-text');
              if (orig) b.innerHTML = orig;
            });
            alert('Something went wrong. Please try again.');
          });
        });
      });
    })();

    // Sticky CTA show/hide on scroll
    const cbtSticky = document.getElementById('cbt-sticky-cta');
    const cbtHeroBtn = document.getElementById('cbt-hero-btn');
    window.addEventListener('scroll', function() {
      if (!cbtSticky || !cbtHeroBtn) return;
      if (cbtHeroBtn.getBoundingClientRect().bottom < 0) {
        cbtSticky.classList.add('visible');
      } else {
        cbtSticky.classList.remove('visible');
      }
    }, { passive: true });

    // Scroll-in animations via IntersectionObserver
    var cbtObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          cbtObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll(
      '.cbt-card, .cbt-feature-item, .cbt-review-card, .cbt-who-card, .cbt-condition-pill, .cbt-stat-card'
    ).forEach(function(el, i) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(28px)';
      el.style.transition = 'opacity 0.6s ' + (i * 0.05) + 's cubic-bezier(0.16,1,0.3,1), transform 0.6s ' + (i * 0.05) + 's cubic-bezier(0.16,1,0.3,1)';
      cbtObserver.observe(el);
    });
  </script>

