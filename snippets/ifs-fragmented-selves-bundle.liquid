  .ifs-final p { font-size:1.1rem;color:var(--c-muted);margin-bottom:44px;line-height:1.75; }

  /* ── STICKY ── */
  .ifs-sticky { position:fixed;bottom:0;left:0;right:0;z-index:999;padding:18px 32px;background:rgba(6,11,18,0.95);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-top:1px solid var(--c-border);display:flex;align-items:center;justify-content:center;gap:32px;transform:translateY(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);box-shadow:0 -20px 60px rgba(0,0,0,0.7); }
  .ifs-sticky.show { transform:translateY(0); }
  .ifs-sticky-text { font-size:1.1rem;font-weight:700;color:#f0fdf4; }
  .ifs-sticky-text span { color:var(--c-green); }

  /* ── FADE ── */
  .ifs-fade { opacity:0;transform:translateY(32px);transition:opacity 0.75s ease,transform 0.75s ease; }
  .ifs-fade.in { opacity:1;transform:translateY(0); }
  .ifs-fade:nth-child(2){transition-delay:0.1s}.ifs-fade:nth-child(3){transition-delay:0.2s}
  .ifs-fade:nth-child(4){transition-delay:0.3s}.ifs-fade:nth-child(5){transition-delay:0.4s}
  .ifs-fade:nth-child(6){transition-delay:0.5s}

  @media(max-width:900px){ .ifs-grid{grid-template-columns:repeat(2,1fr);} .ifs-feat-grid{grid-template-columns:1fr;} .ifs-concept-row{flex-direction:column;} }
  @media(max-width:600px){ .ifs-grid{grid-template-columns:repeat(2,1fr);gap:16px;} .ifs-card{padding:24px 16px;} .ifs-hero h1{letter-spacing:-1.5px;} .ifs-sticky{flex-direction:column;gap:12px;padding:16px 20px;} .ifs-price-main{font-size:4.5rem;} .ifs-btn-primary{padding:18px 32px;width:100%;} }
</style>

