  .ifs-final-orb { position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(52,211,153,0.1),transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);filter:blur(80px);pointer-events:none; }
  .ifs-final-inner { position:relative;z-index:1;max-width:640px;margin:0 auto; }
