  .ifs-concept-title { font-size:1.1rem;font-weight:800;color:#f0fdf4;margin-bottom:8px; }
  .ifs-concept-text { font-size:0.9rem;color:var(--c-muted);line-height:1.6; }

  /* ── BOOKS GRID ── */
  .ifs-books { padding:100px 24px; }
  .ifs-label { display:block;text-align:center;font-size:0.8rem;font-weight:800;letter-spacing:4px;text-transform:uppercase;color:var(--c-green);margin-bottom:16px; }
  .ifs-title { text-align:center;font-size:clamp(2rem,4.5vw,3rem);font-weight:900;letter-spacing:-1.5px;margin-bottom:60px;color:#f0fdf4; }

  .ifs-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:1100px;margin:0 auto; }

  .ifs-card { background:var(--c-bg2);border:1px solid var(--c-border);border-radius:var(--c-radius);padding:40px 24px;display:flex;flex-direction:column;align-items:center;text-align:center;transition:var(--c-ease);position:relative;overflow:hidden;justify-content:space-between; }
