  .ifs-card:hover::before { opacity:1; }

  .ifs-card-num { position:absolute;top:16px;right:16px;width:34px;height:34px;background:linear-gradient(135deg,var(--c-green),var(--c-green2));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-weight:900;color:#fff; }

  .ifs-cover-wrap { width:140px;height:210px;margin-bottom:28px;position:relative;flex-shrink:0; }
  .ifs-cover-wrap::after { content:'';position:absolute;bottom:-10px;left:50%;transform:translateX(-50%);width:80%;height:20px;background:var(--c-green-glow);filter:blur(16px);border-radius:50%;opacity:0;transition:opacity 0.3s; }
  .ifs-card:hover .ifs-cover-wrap::after { opacity:1; }

  .ifs-cover { width:100%;height:100%;object-fit:contain;border-radius:8px;box-shadow:0 16px 45px rgba(0,0,0,0.7),4px 4px 0 rgba(0,0,0,0.3);transition:transform 0.4s ease; }
  .ifs-card:hover .ifs-cover { transform:rotate(-3deg) scale(1.05); }
  .ifs-card-title { font-size:1rem;font-weight:700;line-height:1.45;color:#f0fdf4; }

  /* ── FEATURES ── */
  .ifs-features { padding:100px 24px;background:var(--c-bg2);border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);text-align:center; }
  .ifs-feat-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1000px;margin:0 auto; }
  .ifs-feat { background:var(--c-glass);border:1px solid var(--c-border);border-radius:24px;padding:40px 24px; }
  .ifs-feat-icon { font-size:3rem;margin-bottom:20px;display:block; }
  .ifs-feat-title { font-size:1.2rem;font-weight:800;margin-bottom:12px;color:#f0fdf4; }
  .ifs-feat-desc { font-size:1rem;color:var(--c-muted);line-height:1.7; }

  /* ── FINAL CTA ── */
