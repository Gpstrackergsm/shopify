  .ifs-explainer p { font-size:1.05rem;color:var(--c-muted);line-height:1.8;max-width:700px;margin:0 auto; }
  .ifs-concept-row { display:flex;align-items:stretch;justify-content:center;gap:24px;margin-top:48px;flex-wrap:wrap; }
  .ifs-concept { background:var(--c-glass);border:1px solid var(--c-border);border-radius:16px;padding:28px 24px;text-align:left;flex:1;min-width:240px;backdrop-filter:blur(10px); }
