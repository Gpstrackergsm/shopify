<style>
  .ifs-wrap *, .ifs-wrap *::before, .ifs-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .ifs-wrap {
    --c-bg: #060b12;
    --c-bg2: #091018;
    --c-bg3: #0e1822;
    --c-glass: rgba(255,255,255,0.03);
    --c-border: rgba(255,255,255,0.07);
    --c-green: #34d399;
    --c-green2: #059669;
    --c-green-glow: rgba(52,211,153,0.18);
    --c-teal: #2dd4bf;
    --c-teal-glow: rgba(45,212,191,0.12);
    --c-purple: #a78bfa;
    --c-text: #f0fdf4;
    --c-muted: #94a3b8;
    --c-dim: #64748b;
    --c-radius: 20px;
    --c-ease: all 0.35s cubic-bezier(0.4,0,0.2,1);
    font-family: 'Outfit', sans-serif;
    background: var(--c-bg);
    color: var(--c-text);
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .ifs-hero {
    min-height: 92vh;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    padding: 80px 24px;
    position: relative; overflow: hidden;
  }
  .ifs-orb { position:absolute; border-radius:50%; filter:blur(120px); pointer-events:none; }
  .ifs-orb-1 { width:800px;height:800px;background:radial-gradient(circle,rgba(52,211,153,0.12),transparent 70%);top:-250px;left:50%;transform:translateX(-50%); }
  .ifs-orb-2 { width:500px;height:500px;background:radial-gradient(circle,rgba(167,139,250,0.08),transparent 70%);bottom:-100px;right:-100px; }
  .ifs-orb-3 { width:400px;height:400px;background:radial-gradient(circle,rgba(45,212,191,0.07),transparent 70%);bottom:-60px;left:-80px; }

  .ifs-hero-inner { position:relative;z-index:1;max-width:900px; }

  .ifs-badge {
    display:inline-flex;align-items:center;gap:8px;
    background:rgba(52,211,153,0.1);
    border:1px solid rgba(52,211,153,0.28);
    border-radius:999px;padding:8px 24px;
    font-size:0.8rem;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;
    color:var(--c-green);margin-bottom:32px;backdrop-filter:blur(12px);
  }
  .ifs-badge-dot { width:8px;height:8px;background:var(--c-green);border-radius:50%;animation:ifs-pulse 2s ease-in-out infinite; }
  @keyframes ifs-pulse { 0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.7);} }

  .ifs-hero h1 { font-size:clamp(2.8rem,7vw,5rem);font-weight:900;line-height:1.05;letter-spacing:-2.5px;margin-bottom:28px;color:#f0fdf4; }
  .ifs-green-text { background:linear-gradient(135deg,var(--c-green),#6ee7b7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
  .ifs-purple-text { background:linear-gradient(135deg,var(--c-purple),#c084fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }

  .ifs-sub { font-size:1.18rem;color:var(--c-muted);max-width:680px;margin:0 auto 48px;line-height:1.75;font-weight:400; }

  /* Price */
  .ifs-price-row { display:flex;align-items:center;justify-content:center;gap:24px;margin-bottom:40px;flex-wrap:wrap; }
  .ifs-price-main { font-size:6rem;font-weight:900;line-height:1;letter-spacing:-4px;color:#f0fdf4; }
  .ifs-price-main sup { font-size:2.5rem;letter-spacing:0;vertical-align:super; }
  .ifs-price-meta { display:flex;flex-direction:column;align-items:flex-start;gap:8px; }
  .ifs-price-was { font-size:1.1rem;color:var(--c-dim);text-decoration:line-through;font-weight:600; }
  .ifs-save-pill { font-size:0.85rem;font-weight:800;color:var(--c-green);background:rgba(52,211,153,0.12);padding:5px 14px;border-radius:999px;letter-spacing:0.5px;border:1px solid rgba(52,211,153,0.25); }

  /* Button */
  .ifs-btn { display:inline-flex;align-items:center;gap:12px;font-family:'Outfit',sans-serif;font-weight:800;border:none;border-radius:18px;cursor:pointer;transition:var(--c-ease);text-decoration:none;position:relative;overflow:hidden;letter-spacing:-0.3px; }
  .ifs-btn::after { content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,0.2),transparent);opacity:0;transition:opacity 0.2s; }
  .ifs-btn:hover::after { opacity:1; }
  .ifs-btn-primary { background:linear-gradient(135deg,var(--c-green),var(--c-green2));color:#fff;padding:20px 56px;font-size:1.25rem;box-shadow:0 0 40px var(--c-green-glow),0 8px 24px rgba(0,0,0,0.5); }
  .ifs-btn-primary:hover { transform:translateY(-4px);box-shadow:0 0 60px var(--c-green-glow),0 12px 35px rgba(0,0,0,0.6); }
  .ifs-btn-sm { font-size:0.95rem;padding:12px 28px;border-radius:14px; }

  .ifs-trust { display:flex;align-items:center;justify-content:center;gap:28px;margin-top:28px;flex-wrap:wrap; }
  .ifs-trust-item { display:flex;align-items:center;gap:8px;font-size:0.85rem;color:var(--c-muted);font-weight:500; }
  .ifs-trust-item svg { color:var(--c-green); }

