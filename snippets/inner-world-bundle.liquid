  .ltb-intro h2 { font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:900;letter-spacing:-1px;margin-bottom:18px; }
  .ltb-intro p { font-size:1rem;color:var(--c-dim);line-height:1.8; }
  .ltb-pillars { display:flex;align-items:center;justify-content:center;gap:24px;margin-top:40px;flex-wrap:wrap; }
  .ltb-pillar {
    background:var(--c-glass);border:1px solid var(--c-border);
