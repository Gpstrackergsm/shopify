  .ltb-card:hover::before { opacity:1; }

  .ltb-card-num { position:absolute;top:14px;right:14px;width:30px;height:30px;background:linear-gradient(135deg,var(--c-teal),var(--c-teal2));border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:900;color:#fff; }

  .ltb-cover-wrap { width:130px;height:195px;margin-bottom:22px;position:relative;flex-shrink:0; }
  .ltb-cover-wrap::after { content:'';position:absolute;bottom:-10px;left:50%;transform:translateX(-50%);width:75%;height:18px;background:var(--c-teal-glow);filter:blur(14px);border-radius:50%;opacity:0;transition:opacity 0.3s; }
