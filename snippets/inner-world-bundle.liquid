<style>
  .ltb-wrap *, .ltb-wrap *::before, .ltb-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .ltb-wrap {
    --c-bg:     #080b10;
    --c-bg2:    #0d1117;
    --c-bg3:    #131926;
    --c-glass:  rgba(255,255,255,0.04);
    --c-border: rgba(255,255,255,0.07);
    --c-teal:   #2dd4bf;
    --c-teal2:  #0d9488;
    --c-teal-glow: rgba(45,212,191,0.18);
    --c-amber:  #fbbf24;
    --c-amber-glow: rgba(251,191,36,0.15);
    --c-text:   #f1f5f9;
    --c-muted:  #64748b;
    --c-dim:    #94a3b8;
    --c-radius: 20px;
    --c-ease:   all 0.35s cubic-bezier(0.4,0,0.2,1);
    font-family: 'Outfit', sans-serif;
    background: var(--c-bg);
    color: var(--c-text);
    overflow-x: hidden;
  }

  /* HERO */
  .ltb-hero {
    min-height: 90vh;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    padding: 60px 24px 80px;
    position: relative; overflow: hidden;
  }
  .ltb-orb { position:absolute; border-radius:50%; filter:blur(120px); pointer-events:none; }
  .ltb-orb-1 { width:700px;height:700px;background:radial-gradient(circle,rgba(45,212,191,0.12),transparent 70%);top:-180px;left:50%;transform:translateX(-50%); }
  .ltb-orb-2 { width:420px;height:420px;background:radial-gradient(circle,rgba(251,191,36,0.09),transparent 70%);bottom:0;right:-80px; }
  .ltb-orb-3 { width:350px;height:350px;background:radial-gradient(circle,rgba(45,212,191,0.07),transparent 70%);bottom:0;left:-60px; }

  .ltb-hero-inner { position:relative;z-index:1;max-width:840px; }

  .ltb-badge {
    display:inline-flex;align-items:center;gap:8px;
    background:rgba(45,212,191,0.08);
    border:1px solid rgba(45,212,191,0.2);
    border-radius:999px;padding:8px 22px;
    font-size:0.78rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;
    color:var(--c-teal);margin-bottom:28px;backdrop-filter:blur(12px);
  }
  .ltb-badge-dot {
    width:7px;height:7px;background:var(--c-teal);border-radius:50%;
    animation:ltb-pulse 2s ease-in-out infinite;
  }
  @keyframes ltb-pulse { 0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.7);} }

  .ltb-hero h1 {
    font-size:clamp(2.6rem,6vw,4.8rem);font-weight:900;line-height:1.05;
    letter-spacing:-2px;margin-bottom:24px;
  }
  .ltb-teal-text {
    background:linear-gradient(135deg,var(--c-teal),#5eead4);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  }
  .ltb-amber-text {
    background:linear-gradient(135deg,var(--c-amber),#f59e0b);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  }

  .ltb-sub {
    font-size:1.15rem;color:var(--c-dim);max-width:600px;
    margin:0 auto 44px;line-height:1.75;font-weight:400;
  }

  .ltb-price-row { display:flex;align-items:center;justify-content:center;gap:20px;margin-bottom:36px;flex-wrap:wrap; }
  .ltb-price-main { font-size:5.5rem;font-weight:900;line-height:1;letter-spacing:-4px;color:var(--c-text); }
  .ltb-price-main sup { font-size:2.2rem;letter-spacing:0;vertical-align:super; }
  .ltb-price-meta { display:flex;flex-direction:column;align-items:flex-start;gap:6px; }
  .ltb-price-was { font-size:1.1rem;color:var(--c-muted);text-decoration:line-through;font-weight:600; }
  .ltb-save-pill {
    font-size:0.82rem;font-weight:800;color:var(--c-teal);
    background:rgba(45,212,191,0.12);padding:4px 12px;border-radius:999px;
