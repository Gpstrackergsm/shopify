  .ltb-cover { width:100%;height:100%;object-fit:contain;border-radius:6px;box-shadow:0 14px 40px rgba(0,0,0,0.6),4px 4px 0 rgba(0,0,0,0.25);transition:transform 0.35s ease; }
  .ltb-card:hover .ltb-cover { transform:rotate(-2.5deg) scale(1.05); }
  .ltb-card-title { font-size:0.92rem;font-weight:700;line-height:1.4;color:var(--c-text); }

  /* FEATURES */
  .ltb-features { padding:80px 24px;background:var(--c-bg2);border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border); }
  .ltb-feat-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:1000px;margin:0 auto; }
  .ltb-feat { text-align:center;padding:36px 20px; }
  .ltb-feat-icon { font-size:2.6rem;margin-bottom:16px;display:block; }
  .ltb-feat-title { font-size:1.05rem;font-weight:800;margin-bottom:10px;color:var(--c-text); }
  .ltb-feat-desc { font-size:0.88rem;color:var(--c-muted);line-height:1.75; }

  /* FINAL CTA */
  .ltb-final { padding:120px 24px;text-align:center;position:relative;overflow:hidden; }
  .ltb-final-orb { position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(45,212,191,0.09),transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);filter:blur(80px);pointer-events:none; }
  .ltb-final-inner { position:relative;z-index:1;max-width:640px;margin:0 auto; }
  .ltb-final h2 { font-size:clamp(2rem,4vw,3.4rem);font-weight:900;letter-spacing:-1.5px;margin-bottom:18px;line-height:1.1; }
  .ltb-final p { font-size:1.1rem;color:var(--c-dim);margin-bottom:44px;line-height:1.75; }

  /* STICKY */
  .ltb-sticky { position:fixed;bottom:0;left:0;right:0;z-index:999;padding:16px 32px;background:rgba(8,11,16,0.92);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-top:1px solid var(--c-border);display:flex;align-items:center;justify-content:center;gap:32px;transform:translateY(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);box-shadow:0 -20px 60px rgba(0,0,0,0.6); }
  .ltb-sticky.show { transform:translateY(0); }
  .ltb-sticky-text { font-size:1rem;font-weight:700;color:var(--c-text); }
  .ltb-sticky-text span { color:var(--c-teal); }

  /* FADE */
  .ltb-fade { opacity:0;transform:translateY(32px);transition:opacity 0.75s ease,transform 0.75s ease; }
  .ltb-fade.in { opacity:1;transform:translateY(0); }
  .ltb-fade:nth-child(2){transition-delay:0.1s}.ltb-fade:nth-child(3){transition-delay:0.2s}
  .ltb-fade:nth-child(4){transition-delay:0.3s}.ltb-fade:nth-child(5){transition-delay:0.4s}
  .ltb-fade:nth-child(6){transition-delay:0.5s}

  @media(max-width:900px){ .ltb-grid{grid-template-columns:repeat(2,1fr);} .ltb-feat-grid{grid-template-columns:1fr;} .ltb-pillars{gap:16px;} }
  @media(max-width:600px){ .ltb-grid{grid-template-columns:repeat(2,1fr);gap:14px;} .ltb-card{padding:18px 12px;} .ltb-hero h1{letter-spacing:-1.5px;} .ltb-sticky{flex-direction:column;gap:10px;padding:14px 20px;} .ltb-price-main{font-size:4rem;} }
</style>

