  .ltb-trust-item { display:flex;align-items:center;gap:6px;font-size:0.82rem;color:var(--c-muted);font-weight:500; }
  .ltb-trust-item svg { color:var(--c-teal); }

  /* INTRO */
  .ltb-intro {
    padding:70px 24px;
    background:linear-gradient(135deg,rgba(45,212,191,0.05),rgba(251,191,36,0.03));
