</div>

<script>
  const ltbHeroCta = document.getElementById('ltb-hero-cta');
  const ltbSticky  = document.getElementById('ltb-sticky');
  window.addEventListener('scroll', () => {
    ltbSticky.classList.toggle('show', ltbHeroCta.getBoundingClientRect().bottom < 0);
  }, { passive: true });

  const ltbFades = document.querySelectorAll('.ltb-fade');
  const ltbObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); ltbObs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  ltbFades.forEach(el => ltbObs.observe(el));

  function ltbCheckout() {
    const variants = [
      '{{ v1.id }}','{{ v2.id }}','{{ v3.id }}',
      '{{ v4.id }}','{{ v5.id }}','{{ v6.id }}'
    ];
    if (variants.some(v => !v || v === '')) { alert('Bundle error. Please try again.'); return; }
    document.querySelectorAll('.ltb-btn-primary').forEach(b => { b.textContent = 'Processing\u2026'; b.disabled = true; });
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: variants.map(id => ({ id: parseInt(id), quantity: 1 })) })
      }))
      .then(r => r.json())
      .then(() => { window.location.href = '/checkout'; })
      .catch(err => {
        console.error(err);
        document.querySelectorAll('.ltb-btn-primary').forEach(b => { b.textContent = 'Get Bundle \u2014 $29'; b.disabled = false; });
        alert('Something went wrong. Please try again.');
      });
  }
</script>
