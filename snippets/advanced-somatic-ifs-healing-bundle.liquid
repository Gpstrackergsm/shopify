<div class="sif-sticky" id="sif-sticky">
  <span class="sif-sticky-text">Advanced Somatic &amp; IFS Trauma Bundle — <span>$29.00</span></span>
  <button class="sif-btn sif-btn-primary sif-btn-sm" onclick="sifCheckout()">Buy Now</button>
</div>

<script>
  const sifHeroCta = document.getElementById('sif-hero-cta');
  const sifSticky  = document.getElementById('sif-sticky');
  window.addEventListener('scroll', () => {
    sifSticky.classList.toggle('show', sifHeroCta.getBoundingClientRect().bottom < 0);
  }, { passive: true });

  const sifFades = document.querySelectorAll('.sif-fade');
  const sifObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); sifObs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  sifFades.forEach(el => sifObs.observe(el));

  function sifCheckout() {
    const variants = [
      '{{ v1.id }}','{{ v2.id }}','{{ v3.id }}',
      '{{ v4.id }}','{{ v5.id }}','{{ v6.id }}'
    ];
    if (variants.some(v => !v || v === '')) { alert('Bundle error. Please try again.'); return; }
    document.querySelectorAll('.sif-btn-primary').forEach(b => { b.textContent = 'Processing…'; b.disabled = true; });
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: variants.map(id => ({ id: parseInt(id), quantity: 1 })) })
      }))
      .then(r => r.json())
      .then(() => { window.location.href = '/checkout'; })
      .catch(err => {
        console.error(err);
        document.querySelectorAll('.sif-btn-primary').forEach(b => { b.textContent = 'Get Bundle — $29'; b.disabled = false; });
        alert('Something went wrong. Please try again.');
      });
  }
</script>
