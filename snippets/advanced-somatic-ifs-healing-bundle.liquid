  .sif-orb-3 { width:350px;height:350px;background:radial-gradient(circle,rgba(192,132,252,0.08),transparent 70%);bottom:0;left:-60px; }

  .sif-hero-inner { position:relative;z-index:1;max-width:860px; }

  .sif-badge {
    display:inline-flex;align-items:center;gap:8px;
    background:rgba(192,132,252,0.08);
    border:1px solid rgba(192,132,252,0.2);
