  .sif-card:hover::before { opacity:1; }

  .sif-card-num { position:absolute;top:14px;right:14px;width:30px;height:30px;background:linear-gradient(135deg,var(--c-purple),var(--c-purple2));border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:900;color:#fff; }

  .sif-cover-wrap { width:130px;height:195px;margin-bottom:22px;position:relative;flex-shrink:0; }
