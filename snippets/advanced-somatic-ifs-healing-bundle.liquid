  .sif-price-main { font-size:5.5rem;font-weight:900;line-height:1;letter-spacing:-4px;color:var(--c-text); }
  .sif-price-main sup { font-size:2.2rem;letter-spacing:0;vertical-align:super; }
  .sif-price-meta { display:flex;flex-direction:column;align-items:flex-start;gap:6px; }
  .sif-price-was { font-size:1.1rem;color:var(--c-muted);text-decoration:line-through;font-weight:600; }
