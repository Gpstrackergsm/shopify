  /* STICKY */
  .sif-sticky { position:fixed;bottom:0;left:0;right:0;z-index:999;padding:16px 32px;background:rgba(13,11,24,0.94);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-top:1px solid var(--c-border);display:flex;align-items:center;justify-content:center;gap:32px;transform:translateY(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);box-shadow:0 -20px 60px rgba(0,0,0,0.6); }
  .sif-sticky.show { transform:translateY(0); }
  .sif-sticky-text { font-size:1rem;font-weight:700;color:var(--c-text); }
  .sif-sticky-text span { color:var(--c-purple); }

  /* FADE */
  .sif-fade { opacity:0;transform:translateY(32px);transition:opacity 0.75s ease,transform 0.75s ease; }
  .sif-fade.in { opacity:1;transform:translateY(0); }
  .sif-fade:nth-child(2){transition-delay:0.1s}.sif-fade:nth-child(3){transition-delay:0.2s}
  .sif-fade:nth-child(4){transition-delay:0.3s}.sif-fade:nth-child(5){transition-delay:0.4s}
  .sif-fade:nth-child(6){transition-delay:0.5s}

  @media(max-width:900px){ .sif-grid{grid-template-columns:repeat(2,1fr);} .sif-feat-grid{grid-template-columns:1fr;} .sif-pillars{gap:12px;} }
  @media(max-width:600px){ .sif-grid{grid-template-columns:repeat(2,1fr);gap:14px;} .sif-card{padding:18px 12px;} .sif-hero h1{letter-spacing:-1.5px;} .sif-sticky{flex-direction:column;gap:10px;padding:14px 20px;} .sif-price-main{font-size:4rem;} }
</style>

