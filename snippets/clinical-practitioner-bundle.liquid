<!-- STICKY BAR -->
<div class="cpb-sticky" id="cpb-sticky">
  <span class="cpb-sticky-text">The Clinical Practitioner&#39;s Toolkit — <span>$29.00</span></span>
  <button class="cpb-btn cpb-btn-primary cpb-btn-sm" onclick="cpbCheckout()">Buy Now</button>
</div>

<script>
  const cpbHeroCta = document.getElementById('cpb-hero-cta');
  const cpbSticky  = document.getElementById('cpb-sticky');
  window.addEventListener('scroll', () => {
    cpbSticky.classList.toggle('show', cpbHeroCta.getBoundingClientRect().bottom < 0);
  }, { passive: true });

  const cpbFades = document.querySelectorAll('.cpb-fade');
  const cpbObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); cpbObs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  cpbFades.forEach(el => cpbObs.observe(el));

  function cpbCheckout() {
    const variants = [
      '{{ v1.id }}','{{ v2.id }}','{{ v3.id }}',
      '{{ v4.id }}','{{ v5.id }}','{{ v6.id }}'
    ];
    if (variants.some(v => !v || v === '')) { alert('Bundle error. Please try again.'); return; }
    document.querySelectorAll('.cpb-btn-primary').forEach(b => { b.textContent = 'Processing…'; b.disabled = true; });
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: variants.map(id => ({ id: parseInt(id), quantity: 1 })) })
      }))
      .then(r => r.json())
      .then(() => { window.location.href = '/checkout'; })
      .catch(err => {
        console.error(err);
        document.querySelectorAll('.cpb-btn-primary').forEach(b => { b.textContent = 'Get Bundle — $29'; b.disabled = false; });
        alert('Something went wrong. Please try again.');
      });
  }
</script>
