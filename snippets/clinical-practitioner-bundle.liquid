<style>
  .cpb-wrap *, .cpb-wrap *::before, .cpb-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .cpb-wrap {
    --c-bg:     #0b1329;
    --c-bg2:    #101a36;
    --c-bg3:    #172447;
    --c-glass:  rgba(255,255,255,0.04);
    --c-border: rgba(255,255,255,0.08);
    --c-blue:   #38bdf8;
    --c-blue2:  #0284c7;
    --c-blue-glow: rgba(56,189,248,0.18);
    --c-teal:   #2dd4bf;
    --c-text:   #f1f5f9;
    --c-muted:  #64748b;
    --c-dim:    #94a3b8;
    --c-radius: 20px;
    --c-ease:   all 0.35s cubic-bezier(0.4,0,0.2,1);
    font-family: 'Outfit', sans-serif;
    background: var(--c-bg);
    color: var(--c-text);
    overflow-x: hidden;
  }

  /* HERO */
  .cpb-hero {
    min-height: 90vh;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    padding: 60px 24px 80px;
    position: relative; overflow: hidden;
  }
  .cpb-orb { position:absolute; border-radius:50%; filter:blur(120px); pointer-events:none; }
  .cpb-orb-1 { width:700px;height:700px;background:radial-gradient(circle,rgba(56,189,248,0.14),transparent 70%);top:-180px;left:50%;transform:translateX(-50%); }
  .cpb-orb-2 { width:420px;height:420px;background:radial-gradient(circle,rgba(45,212,191,0.10),transparent 70%);bottom:0;right:-80px; }
  .cpb-orb-3 { width:350px;height:350px;background:radial-gradient(circle,rgba(56,189,248,0.08),transparent 70%);bottom:0;left:-60px; }

  .cpb-hero-inner { position:relative;z-index:1;max-width:860px; }

  .cpb-badge {
    display:inline-flex;align-items:center;gap:8px;
    background:rgba(56,189,248,0.08);
    border:1px solid rgba(56,189,248,0.2);
    border-radius:999px;padding:8px 22px;
    font-size:0.78rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;
    color:var(--c-blue);margin-bottom:28px;backdrop-filter:blur(12px);
  }
  .cpb-badge-dot {
    width:7px;height:7px;background:var(--c-blue);border-radius:50%;
    animation:cpb-pulse 2s ease-in-out infinite;
  }
  @keyframes cpb-pulse { 0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.7);} }

  .cpb-hero h1 {
    font-size:clamp(2.5rem,5.8vw,4.6rem);font-weight:900;line-height:1.06;
    letter-spacing:-2px;margin-bottom:24px;
  }
  .cpb-blue-text {
    background:linear-gradient(135deg,var(--c-blue),#7dd3fc);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  }
  .cpb-teal-text {
    background:linear-gradient(135deg,var(--c-teal),#5eead4);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  }

  .cpb-sub {
    font-size:1.15rem;color:var(--c-dim);max-width:640px;
    margin:0 auto 44px;line-height:1.75;font-weight:400;
  }

  .cpb-price-row { display:flex;align-items:center;justify-content:center;gap:20px;margin-bottom:36px;flex-wrap:wrap; }
  .cpb-price-main { font-size:5.5rem;font-weight:900;line-height:1;letter-spacing:-4px;color:var(--c-text); }
  .cpb-price-main sup { font-size:2.2rem;letter-spacing:0;vertical-align:super; }
  .cpb-price-meta { display:flex;flex-direction:column;align-items:flex-start;gap:6px; }
  .cpb-price-was { font-size:1.1rem;color:var(--c-muted);text-decoration:line-through;font-weight:600; }
  .cpb-save-pill {
    font-size:0.82rem;font-weight:800;color:var(--c-blue);
    background:rgba(56,189,248,0.12);padding:4px 12px;border-radius:999px;
    letter-spacing:0.5px;border:1px solid rgba(56,189,248,0.25);
  }

  .cpb-btn {
    display:inline-flex;align-items:center;gap:10px;
    font-family:'Outfit',sans-serif;font-weight:800;
    border:none;border-radius:16px;cursor:pointer;
    transition:var(--c-ease);text-decoration:none;
    position:relative;overflow:hidden;letter-spacing:-0.3px;
  }
