  .cpb-btn:hover::after { opacity:1; }
  .cpb-btn-primary {
    background:linear-gradient(135deg,var(--c-blue),var(--c-blue2));
    color:#fff;padding:18px 52px;font-size:1.15rem;
    box-shadow:0 0 40px var(--c-blue-glow),0 6px 20px rgba(0,0,0,0.4);
  }
  .cpb-btn-primary:hover { transform:translateY(-3px);box-shadow:0 0 60px var(--c-blue-glow),0 10px 30px rgba(0,0,0,0.5); }
  .cpb-btn-sm { font-size:0.9rem;padding:11px 24px;border-radius:12px; }

  .cpb-trust { display:flex;align-items:center;justify-content:center;gap:24px;margin-top:22px;flex-wrap:wrap; }
  .cpb-trust-item { display:flex;align-items:center;gap:6px;font-size:0.82rem;color:var(--c-muted);font-weight:500; }
  .cpb-trust-item svg { color:var(--c-blue); }

  /* INTRO */
  .cpb-intro {
    padding:70px 24px;
    background:linear-gradient(135deg,rgba(56,189,248,0.05),rgba(45,212,191,0.03));
    border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);
    text-align:center;
  }
  .cpb-intro-inner { max-width:740px;margin:0 auto; }
  .cpb-intro h2 { font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:900;letter-spacing:-1px;margin-bottom:18px; }
  .cpb-intro p { font-size:1rem;color:var(--c-dim);line-height:1.8; }
  .cpb-pillars { display:flex;align-items:center;justify-content:center;gap:20px;margin-top:40px;flex-wrap:wrap; }
  .cpb-pillar {
    background:var(--c-glass);border:1px solid var(--c-border);
    border-radius:14px;padding:18px 22px;text-align:center;min-width:130px;
    backdrop-filter:blur(10px);
  }
  .cpb-pillar-icon { font-size:1.8rem;margin-bottom:8px;display:block; }
  .cpb-pillar-name { font-size:0.83rem;font-weight:800;color:var(--c-text);letter-spacing:0.5px; }

  /* BOOKS GRID */
  .cpb-books { padding:100px 24px; }
  .cpb-label { display:block;text-align:center;font-size:0.73rem;font-weight:800;letter-spacing:3px;text-transform:uppercase;color:var(--c-blue);margin-bottom:14px; }
  .cpb-title { text-align:center;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:900;letter-spacing:-1.5px;margin-bottom:60px;color:var(--c-text); }

  .cpb-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1100px;margin:0 auto; }

  .cpb-card {
    background:var(--c-glass);border:1px solid var(--c-border);border-radius:var(--c-radius);
    padding:32px 22px;display:flex;flex-direction:column;align-items:center;
    text-align:center;transition:var(--c-ease);backdrop-filter:blur(10px);
    position:relative;overflow:hidden;
  }
  .cpb-card::before { content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(56,189,248,0.07),transparent,rgba(45,212,191,0.04));opacity:0;transition:opacity 0.3s; }
  .cpb-card:hover { transform:translateY(-10px);border-color:rgba(56,189,248,0.35);box-shadow:0 24px 60px rgba(0,0,0,0.5),0 0 40px var(--c-blue-glow); }
  .cpb-card:hover::before { opacity:1; }

  .cpb-card-num { position:absolute;top:14px;right:14px;width:30px;height:30px;background:linear-gradient(135deg,var(--c-blue),var(--c-blue2));border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:900;color:#fff; }

  .cpb-cover-wrap { width:130px;height:195px;margin-bottom:22px;position:relative;flex-shrink:0; }
  .cpb-cover-wrap::after { content:'';position:absolute;bottom:-10px;left:50%;transform:translateX(-50%);width:75%;height:18px;background:var(--c-blue-glow);filter:blur(14px);border-radius:50%;opacity:0;transition:opacity 0.3s; }
  .cpb-card:hover .cpb-cover-wrap::after { opacity:1; }

  .cpb-cover { width:100%;height:100%;object-fit:contain;border-radius:6px;box-shadow:0 14px 40px rgba(0,0,0,0.6),4px 4px 0 rgba(0,0,0,0.25);transition:transform 0.35s ease; }
  .cpb-card:hover .cpb-cover { transform:rotate(-2.5deg) scale(1.05); }
  .cpb-card-title { font-size:0.92rem;font-weight:700;line-height:1.4;color:var(--c-text); }

  /* FEATURES */
  .cpb-features { padding:80px 24px;background:var(--c-bg2);border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border); }
  .cpb-feat-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:1000px;margin:0 auto; }
  .cpb-feat { text-align:center;padding:36px 20px; }
  .cpb-feat-icon { font-size:2.6rem;margin-bottom:16px;display:block; }
  .cpb-feat-title { font-size:1.05rem;font-weight:800;margin-bottom:10px;color:var(--c-text); }
  .cpb-feat-desc { font-size:0.88rem;color:var(--c-muted);line-height:1.75; }

  /* FINAL CTA */
  .cpb-final { padding:120px 24px;text-align:center;position:relative;overflow:hidden; }
  .cpb-final-orb { position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(56,189,248,0.09),transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);filter:blur(80px);pointer-events:none; }
  .cpb-final-inner { position:relative;z-index:1;max-width:640px;margin:0 auto; }
  .cpb-final h2 { font-size:clamp(2rem,4vw,3.4rem);font-weight:900;letter-spacing:-1.5px;margin-bottom:18px;line-height:1.1; }
  .cpb-final p { font-size:1.1rem;color:var(--c-dim);margin-bottom:44px;line-height:1.75; }

  /* STICKY */
  .cpb-sticky { position:fixed;bottom:0;left:0;right:0;z-index:999;padding:16px 32px;background:rgba(11,19,41,0.94);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-top:1px solid var(--c-border);display:flex;align-items:center;justify-content:center;gap:32px;transform:translateY(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);box-shadow:0 -20px 60px rgba(0,0,0,0.6); }
  .cpb-sticky.show { transform:translateY(0); }
  .cpb-sticky-text { font-size:1rem;font-weight:700;color:var(--c-text); }
  .cpb-sticky-text span { color:var(--c-blue); }

  /* FADE */
  .cpb-fade { opacity:0;transform:translateY(32px);transition:opacity 0.75s ease,transform 0.75s ease; }
  .cpb-fade.in { opacity:1;transform:translateY(0); }
  .cpb-fade:nth-child(2){transition-delay:0.1s}.cpb-fade:nth-child(3){transition-delay:0.2s}
  .cpb-fade:nth-child(4){transition-delay:0.3s}.cpb-fade:nth-child(5){transition-delay:0.4s}
  .cpb-fade:nth-child(6){transition-delay:0.5s}

  @media(max-width:900px){ .cpb-grid{grid-template-columns:repeat(2,1fr);} .cpb-feat-grid{grid-template-columns:1fr;} .cpb-pillars{gap:12px;} }
  @media(max-width:600px){ .cpb-grid{grid-template-columns:repeat(2,1fr);gap:14px;} .cpb-card{padding:18px 12px;} .cpb-hero h1{letter-spacing:-1.5px;} .cpb-sticky{flex-direction:column;gap:10px;padding:14px 20px;} .cpb-price-main{font-size:4rem;} }
</style>

