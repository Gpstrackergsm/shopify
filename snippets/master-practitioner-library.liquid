<script>
  function mplShowPanel(idx, btn) {
    document.querySelectorAll('.mpl-bundle-panel').forEach((p,i) => p.classList.toggle('active', i === idx));
    document.querySelectorAll('.mpl-tab').forEach((t,i) => t.classList.toggle('active', i === idx));
  }

  function mplToggleFaq(btn) {
    const item = btn.closest('.mpl-faq-item');
    item.classList.toggle('open');
  }

  function mplCheckout() {
    const variants = [
      '{{ v1.id }}','{{ v2.id }}','{{ v3.id }}','{{ v4.id }}','{{ v5.id }}','{{ v6.id }}',
      '{{ v7.id }}','{{ v8.id }}','{{ v9.id }}','{{ v10.id }}',
      '{{ v11.id }}','{{ v12.id }}','{{ v13.id }}','{{ v14.id }}','{{ v15.id }}'
    ];
    const valid = variants.filter(v => v && v !== '' && v !== '0');
    if (valid.length === 0) { alert('Bundle error. Please try again.'); return; }
    document.querySelectorAll('.mpl-buy-btn,.mpl-nav-cta,.mpl-final-btn,.mpl-sticky-btn').forEach(b => {
      b.textContent = 'Processing…'; b.disabled = true;
    });
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: valid.map(id => ({ id: parseInt(id), quantity: 1 })) })
      }))
      .then(r => r.json())
      .then(() => { window.location.href = '/checkout'; })
      .catch(err => {
        console.error(err);
        document.querySelectorAll('.mpl-buy-btn,.mpl-nav-cta,.mpl-final-btn,.mpl-sticky-btn').forEach(b => {
          b.disabled = false; b.textContent = 'Get Library Pass — $59';
        });
        alert('Something went wrong. Please try again.');
      });
  }
</script>
