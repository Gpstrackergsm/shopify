  Psychology of Success — 6-Book Bundle
  Snippet: psychology-of-success-bundle.liquid
  Page template: page.psychology-of-success-bundle.liquid
{% endcomment %}

{% assign p1 = all_products['mans-search-for-meaning'] %}
{% assign v1 = p1.variants.first %}
{% assign p2 = all_products['psycho-cybernetics-updated-and-expanded-the-psycho-cybernetics-series'] %}
{% assign v2 = p2.variants.first %}
{% assign p3 = all_products['influence-the-psychology-of-persuasion-revised-edition'] %}
{% assign v3 = p3.variants.first %}
{% assign p4 = all_products['the-48-laws-of-power'] %}
{% assign v4 = p4.variants.first %}
{% assign p5 = all_products['zero-to-one'] %}
{% assign v5 = p5.variants.first %}
{% assign p6 = all_products['principles-for-dealing-with-the-changing-world-order-why-nations-succeed-and-fail'] %}
