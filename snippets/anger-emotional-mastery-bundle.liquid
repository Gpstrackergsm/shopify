<!-- STICKY BAR -->
<div class="aem-sticky" id="aem-sticky">
  <span class="aem-sticky-text">Anger &amp; Emotional Mastery Bundle — <span>$29.00</span></span>
  <button class="aem-btn aem-btn-primary aem-btn-sm" onclick="aemCheckout()">Buy Now</button>
</div>

<script>
  const aemHeroCta = document.getElementById('aem-hero-cta');
  const aemSticky  = document.getElementById('aem-sticky');
  window.addEventListener('scroll', () => {
    if (aemSticky && aemHeroCta) {
      aemSticky.classList.toggle('show', aemHeroCta.getBoundingClientRect().bottom < 0);
    }
  }, { passive: true });

  const aemFades = document.querySelectorAll('.aem-fade');
  const aemObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); aemObs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  aemFades.forEach(el => aemObs.observe(el));

  function aemCheckout() {
    const variants = [
      '{{ v1.id }}','{{ v2.id }}','{{ v3.id }}',
      '{{ v4.id }}','{{ v5.id }}','{{ v6.id }}'
    ];
    if (variants.some(v => !v || v === '')) { alert('Bundle error. Please try again.'); return; }
    document.querySelectorAll('.aem-btn-primary').forEach(b => { b.textContent = 'Processing…'; b.disabled = true; });
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: variants.map(id => ({ id: parseInt(id), quantity: 1 })) })
      }))
      .then(r => r.json())
      .then(() => { window.location.href = '/checkout'; })
      .catch(err => {
        console.error(err);
        document.querySelectorAll('.aem-btn-primary').forEach(b => { b.textContent = 'Get Bundle — $29'; b.disabled = false; });
        alert('Something went wrong. Please try again.');
      });
  }
</script>
