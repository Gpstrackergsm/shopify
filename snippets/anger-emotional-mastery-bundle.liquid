<style>
  .aem-wrap *, .aem-wrap *::before, .aem-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .aem-wrap {
    --c-bg: #0f0a05;
    --c-bg2: #160e06;
    --c-bg3: #1e1408;
    --c-glass: rgba(255,255,255,0.03);
    --c-border: rgba(255,255,255,0.07);
    --c-orange: #f97316;
    --c-orange2: #c2410c;
    --c-orange-glow: rgba(249,115,22,0.18);
    --c-amber: #fbbf24;
    --c-amber-glow: rgba(251,191,36,0.15);
    --c-red: #f87171;
    --c-text: #fef3c7;
    --c-muted: #92400e;
    --c-dim: #78716c;
    --c-light: #fef9f0;
    --c-radius: 20px;
    --c-ease: all 0.35s cubic-bezier(0.4,0,0.2,1);
    font-family: 'Outfit', sans-serif;
    background: var(--c-bg);
    color: var(--c-light);
    overflow-x: hidden;
