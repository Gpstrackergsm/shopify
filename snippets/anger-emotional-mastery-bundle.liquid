  .aem-btn:hover::after { opacity:1; }
  .aem-btn-primary { background:linear-gradient(135deg,var(--c-orange),var(--c-orange2));color:#fff;padding:20px 56px;font-size:1.25rem;box-shadow:0 0 40px var(--c-orange-glow),0 8px 24px rgba(0,0,0,0.5); }
  .aem-btn-primary:hover { transform:translateY(-4px);box-shadow:0 0 60px var(--c-orange-glow),0 12px 35px rgba(0,0,0,0.6); }
  .aem-btn-sm { font-size:0.95rem;padding:12px 28px;border-radius:14px; }

  .aem-trust { display:flex;align-items:center;justify-content:center;gap:28px;margin-top:28px;flex-wrap:wrap; }
  .aem-trust-item { display:flex;align-items:center;gap:8px;font-size:0.85rem;color:#a8a29e;font-weight:500; }
  .aem-trust-item svg { color:var(--c-orange); }

  /* ── EXPLAINER ── */
  .aem-explainer { padding:80px 24px;background:var(--c-bg2);border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);text-align:center; }
  .aem-explainer h2 { font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900;letter-spacing:-1px;margin-bottom:18px; }
  .aem-explainer p { font-size:1.05rem;color:#d6d3d1;line-height:1.8;max-width:700px;margin:0 auto; }
  .aem-concept-row { display:flex;align-items:stretch;justify-content:center;gap:24px;margin-top:48px;flex-wrap:wrap; }
  .aem-concept { background:var(--c-glass);border:1px solid var(--c-border);border-radius:16px;padding:28px 24px;text-align:left;flex:1;min-width:240px;backdrop-filter:blur(10px); }
  .aem-concept-icon { font-size:2.2rem;margin-bottom:14px;display:block; }
  .aem-concept-title { font-size:1.1rem;font-weight:800;color:var(--c-light);margin-bottom:8px; }
  .aem-concept-text { font-size:0.9rem;color:#a8a29e;line-height:1.6; }

  /* ── BOOKS GRID ── */
  .aem-books { padding:100px 24px;background:var(--c-bg); }
  .aem-label { display:block;text-align:center;font-size:0.8rem;font-weight:800;letter-spacing:4px;text-transform:uppercase;color:var(--c-orange);margin-bottom:16px; }
  .aem-title { text-align:center;font-size:clamp(2rem,4.5vw,3rem);font-weight:900;letter-spacing:-1.5px;margin-bottom:60px;color:var(--c-light); }

  .aem-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:1100px;margin:0 auto; }

  .aem-card { background:var(--c-bg2);border:1px solid var(--c-border);border-radius:var(--c-radius);padding:40px 24px;display:flex;flex-direction:column;align-items:center;text-align:center;transition:var(--c-ease);position:relative;overflow:hidden;justify-content:space-between; }
  .aem-card::before { content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(249,115,22,0.07),transparent,rgba(251,191,36,0.03));opacity:0;transition:opacity 0.3s; }
  .aem-card:hover { transform:translateY(-10px);border-color:rgba(249,115,22,0.4);box-shadow:0 24px 60px rgba(0,0,0,0.6),0 0 40px var(--c-orange-glow); }
  .aem-card:hover::before { opacity:1; }

  .aem-card-num { position:absolute;top:16px;right:16px;width:34px;height:34px;background:linear-gradient(135deg,var(--c-orange),var(--c-orange2));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-weight:900;color:#fff; }

  .aem-cover-wrap { width:140px;height:210px;margin-bottom:28px;position:relative;flex-shrink:0; }
  .aem-cover-wrap::after { content:'';position:absolute;bottom:-10px;left:50%;transform:translateX(-50%);width:80%;height:20px;background:var(--c-orange-glow);filter:blur(16px);border-radius:50%;opacity:0;transition:opacity 0.3s; }
  .aem-card:hover .aem-cover-wrap::after { opacity:1; }

  .aem-cover { width:100%;height:100%;object-fit:contain;border-radius:8px;box-shadow:0 16px 45px rgba(0,0,0,0.7),4px 4px 0 rgba(0,0,0,0.3);transition:transform 0.4s ease; }
  .aem-card:hover .aem-cover { transform:rotate(-3deg) scale(1.05); }
  .aem-card-title { font-size:1rem;font-weight:700;line-height:1.45;color:var(--c-light); }

  /* ── FEATURES ── */
  .aem-features { padding:100px 24px;background:var(--c-bg2);border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);text-align:center; }
  .aem-feat-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1000px;margin:0 auto; }
  .aem-feat { background:var(--c-glass);border:1px solid var(--c-border);border-radius:24px;padding:40px 24px; }
  .aem-feat-icon { font-size:3rem;margin-bottom:20px;display:block; }
  .aem-feat-title { font-size:1.2rem;font-weight:800;margin-bottom:12px;color:var(--c-light); }
  .aem-feat-desc { font-size:1rem;color:#a8a29e;line-height:1.7; }

  /* ── FINAL CTA ── */
  .aem-final { padding:120px 24px;text-align:center;position:relative;overflow:hidden; }
  .aem-final-orb { position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(249,115,22,0.1),transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);filter:blur(80px);pointer-events:none; }
  .aem-final-inner { position:relative;z-index:1;max-width:640px;margin:0 auto; }
  .aem-final h2 { font-size:clamp(2rem,4vw,3.4rem);font-weight:900;letter-spacing:-1.5px;margin-bottom:18px;line-height:1.1; }
  .aem-final p { font-size:1.1rem;color:#d6d3d1;margin-bottom:44px;line-height:1.75; }

  /* ── STICKY ── */
  .aem-sticky { position:fixed;bottom:0;left:0;right:0;z-index:999;padding:18px 32px;background:rgba(15,10,5,0.95);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-top:1px solid var(--c-border);display:flex;align-items:center;justify-content:center;gap:32px;transform:translateY(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);box-shadow:0 -20px 60px rgba(0,0,0,0.7); }
  .aem-sticky.show { transform:translateY(0); }
  .aem-sticky-text { font-size:1.1rem;font-weight:700;color:var(--c-light); }
  .aem-sticky-text span { color:var(--c-orange); }

  /* ── FADE ── */
  .aem-fade { opacity:0;transform:translateY(32px);transition:opacity 0.75s ease,transform 0.75s ease; }
  .aem-fade.in { opacity:1;transform:translateY(0); }
  .aem-fade:nth-child(2){transition-delay:0.1s}.aem-fade:nth-child(3){transition-delay:0.2s}
  .aem-fade:nth-child(4){transition-delay:0.3s}.aem-fade:nth-child(5){transition-delay:0.4s}
  .aem-fade:nth-child(6){transition-delay:0.5s}

  @media(max-width:900px){ .aem-grid{grid-template-columns:repeat(2,1fr);} .aem-feat-grid{grid-template-columns:1fr;} .aem-concept-row{flex-direction:column;} }
  @media(max-width:600px){ .aem-grid{grid-template-columns:repeat(2,1fr);gap:16px;} .aem-card{padding:24px 16px;} .aem-hero h1{letter-spacing:-1.5px;} .aem-sticky{flex-direction:column;gap:12px;padding:16px 20px;} .aem-price-main{font-size:4.5rem;} .aem-btn-primary{padding:18px 32px;width:100%;} }
</style>

