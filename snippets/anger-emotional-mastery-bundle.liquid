  /* ── HERO ── */
  .aem-hero {
    min-height: 92vh;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    padding: 80px 24px;
    position: relative; overflow: hidden;
  }
  .aem-orb { position:absolute; border-radius:50%; filter:blur(120px); pointer-events:none; }
  .aem-orb-1 { width:800px;height:800px;background:radial-gradient(circle,rgba(249,115,22,0.14),transparent 70%);top:-250px;left:50%;transform:translateX(-50%); }
  .aem-orb-2 { width:500px;height:500px;background:radial-gradient(circle,rgba(251,191,36,0.08),transparent 70%);bottom:-80px;right:-100px; }
  .aem-orb-3 { width:400px;height:400px;background:radial-gradient(circle,rgba(248,113,113,0.06),transparent 70%);bottom:-60px;left:-80px; }

  .aem-hero-inner { position:relative;z-index:1;max-width:900px; }

  .aem-badge {
    display:inline-flex;align-items:center;gap:8px;
    background:rgba(249,115,22,0.1);
    border:1px solid rgba(249,115,22,0.28);
    border-radius:999px;padding:8px 24px;
    font-size:0.8rem;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;
    color:var(--c-orange);margin-bottom:32px;backdrop-filter:blur(12px);
  }
  .aem-badge-dot { width:8px;height:8px;background:var(--c-orange);border-radius:50%;animation:aem-pulse 2s ease-in-out infinite; }
  @keyframes aem-pulse { 0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.7);} }

  .aem-hero h1 { font-size:clamp(2.8rem,7vw,5rem);font-weight:900;line-height:1.05;letter-spacing:-2.5px;margin-bottom:28px;color:var(--c-light); }
  .aem-orange-text { background:linear-gradient(135deg,var(--c-orange),#fb923c);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
  .aem-amber-text { background:linear-gradient(135deg,var(--c-amber),#fcd34d);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }

  .aem-sub { font-size:1.18rem;color:#d6d3d1;max-width:680px;margin:0 auto 48px;line-height:1.75;font-weight:400; }

  /* Price */
  .aem-price-row { display:flex;align-items:center;justify-content:center;gap:24px;margin-bottom:40px;flex-wrap:wrap; }
  .aem-price-main { font-size:6rem;font-weight:900;line-height:1;letter-spacing:-4px;color:var(--c-light); }
  .aem-price-main sup { font-size:2.5rem;letter-spacing:0;vertical-align:super; }
  .aem-price-meta { display:flex;flex-direction:column;align-items:flex-start;gap:8px; }
  .aem-price-was { font-size:1.1rem;color:var(--c-dim);text-decoration:line-through;font-weight:600; }
  .aem-save-pill { font-size:0.85rem;font-weight:800;color:var(--c-orange);background:rgba(249,115,22,0.12);padding:5px 14px;border-radius:999px;letter-spacing:0.5px;border:1px solid rgba(249,115,22,0.25); }

  /* Button */
  .aem-btn { display:inline-flex;align-items:center;gap:12px;font-family:'Outfit',sans-serif;font-weight:800;border:none;border-radius:18px;cursor:pointer;transition:var(--c-ease);text-decoration:none;position:relative;overflow:hidden;letter-spacing:-0.3px; }
