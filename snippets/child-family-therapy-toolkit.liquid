<div class="cft-sticky" id="cft-sticky">
  <span class="cft-sticky-text">Child &amp; Family Therapy Toolkit — <span>$29.00</span></span>
  <button class="cft-btn cft-btn-primary cft-btn-sm" onclick="cftCheckout()">Buy Now</button>
</div>

<script>
  const cftHeroCta = document.getElementById('cft-hero-cta');
  const cftSticky  = document.getElementById('cft-sticky');
  window.addEventListener('scroll', () => {
    cftSticky.classList.toggle('show', cftHeroCta.getBoundingClientRect().bottom < 0);
  }, { passive: true });

  const cftFades = document.querySelectorAll('.cft-fade');
  const cftObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); cftObs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  cftFades.forEach(el => cftObs.observe(el));

  function cftCheckout() {
    const variants = [
      '{{ v1.id }}','{{ v2.id }}','{{ v3.id }}',
      '{{ v4.id }}','{{ v5.id }}','{{ v6.id }}'
    ];
    if (variants.some(v => !v || v === '')) { alert('Bundle error. Please try again.'); return; }
    document.querySelectorAll('.cft-btn-primary').forEach(b => { b.textContent = 'Processing…'; b.disabled = true; });
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: variants.map(id => ({ id: parseInt(id), quantity: 1 })) })
      }))
      .then(r => r.json())
      .then(() => { window.location.href = '/checkout'; })
      .catch(err => {
        console.error(err);
        document.querySelectorAll('.cft-btn-primary').forEach(b => { b.textContent = 'Get Bundle — $29'; b.disabled = false; });
        alert('Something went wrong. Please try again.');
      });
  }
</script>
