<!-- STICKY BAR -->
<div class="unb-sticky" id="unb-sticky">
  <span class="unb-sticky-text">Ultimate Nervous System & Trauma Bundle — <span>$29.00</span></span>
  <button class="unb-btn unb-btn-primary unb-btn-sm" onclick="unbCheckout()">Download Now</button>
</div>

<script>
  const unbHeroCta = document.getElementById('unb-hero-cta');
  const unbSticky  = document.getElementById('unb-sticky');
  window.addEventListener('scroll', () => {
    if (unbSticky && unbHeroCta) {
      unbSticky.classList.toggle('show', unbHeroCta.getBoundingClientRect().bottom < 0);
    }
  }, { passive: true });

  const unbFades = document.querySelectorAll('.unb-fade');
  const unbObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); unbObs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  unbFades.forEach(el => unbObs.observe(el));

  function unbCheckout() {
    const variants = [
      '{{ v1.id }}','{{ v2.id }}','{{ v3.id }}',
      '{{ v4.id }}','{{ v5.id }}','{{ v6.id }}'
    ];
    if (variants.some(v => !v || v === '')) { alert('Bundle error. Please try again.'); return; }
    document.querySelectorAll('.unb-btn-primary').forEach(b => { b.textContent = 'Processing…'; b.disabled = true; });
    fetch('/cart/clear.js', { method: 'POST' })
      .then(() => fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: variants.map(id => ({ id: parseInt(id), quantity: 1 })) })
      }))
      .then(r => r.json())
      .then(() => { window.location.href = '/checkout'; })
      .catch(err => {
        console.error(err);
        document.querySelectorAll('.unb-btn-primary').forEach(b => { b.textContent = 'Get Bundle — $29'; b.disabled = false; });
        alert('Something went wrong. Please try again.');
      });
  }
</script>
