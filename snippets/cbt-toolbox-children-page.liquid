  <div class="sticky-cta" id="sticky-cta">
    <span class="sticky-label">CBT Toolbox — <span class="sticky-price">$11 only</span></span>
    <button class="btn btn-primary btn-sm" onclick="checkoutProduct()" id="sticky-btn">Buy Now</button>
  </div>

  <script>
    // Sticky CTA visibility
    var heroBtn = document.getElementById('hero-btn');
    var stickyCta = document.getElementById('sticky-cta');
    window.addEventListener('scroll', function() {
      stickyCta.classList.toggle('show', heroBtn.getBoundingClientRect().bottom < 0);
    });

    // Checkout
    function checkoutProduct() {
      var variantId = '{{ current_variant.id }}';
      if (!variantId || variantId === '') {
        alert('Product not available. Please try again.');
        return;
      }
      var allBtns = document.querySelectorAll('#nav-btn, #hero-btn, #cta-btn, #sticky-btn');
      allBtns.forEach(function(b) { b.textContent = 'Processing…'; b.disabled = true; });

      fetch('/cart/clear.js', { method: 'POST' })
        .then(function() {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
          });
        })
        .then(function(r) { return r.json(); })
        .then(function() { window.location.href = '/checkout'; })
        .catch(function(err) {
          console.error(err);
          alert('Something went wrong. Please try again.');
          allBtns.forEach(function(b) { b.disabled = false; });
          document.getElementById('nav-btn').textContent = '🛒 Get It for $11';
          document.getElementById('hero-btn').textContent = '🛒 Download Now — Only $11';
          document.getElementById('cta-btn').textContent = '🛒 Download Now for $11';
          document.getElementById('sticky-btn').textContent = 'Buy Now';
        });
    }
  </script>
</body>
</html>
