    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(180,83,9,0.45); }
    .btn-sm { font-size: 0.88rem; padding: 9px 20px; border-radius: 8px; }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none !important; }

    /* Urgency bar */
