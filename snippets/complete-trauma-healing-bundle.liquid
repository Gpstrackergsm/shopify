  <script>
    // Sticky CTA
    const heroBtn = document.getElementById('hero-btn');
    const stickyCta = document.getElementById('sticky-cta');
    window.addEventListener('scroll', function() {
      if (heroBtn.getBoundingClientRect().bottom < 0) {
        stickyCta.classList.add('show');
      } else {
        stickyCta.classList.remove('show');
      }
    });

    // Countdown timer
    function startCountdown() {
      var key = 'trauma_bundle_end';
      var end = sessionStorage.getItem(key);
      if (!end) {
        end = Date.now() + 24 * 60 * 60 * 1000;
        sessionStorage.setItem(key, end);
      }
      var el = document.getElementById('timer');
      function tick() {
        var diff = parseInt(end) - Date.now();
        if (diff <= 0) { el.textContent = '00:00:00'; return; }
        var h = Math.floor(diff / 3600000).toString().padStart(2, '0');
        var m = Math.floor((diff % 3600000) / 60000).toString().padStart(2, '0');
        var s = Math.floor((diff % 60000) / 1000).toString().padStart(2, '0');
        el.textContent = h + ':' + m + ':' + s;
        setTimeout(tick, 1000);
      }
      tick();
    }
    startCountdown();

    // Checkout
    function checkoutBundle() {
      var variants = [
        '{{ v1.id }}', '{{ v2.id }}', '{{ v3.id }}',
        '{{ v4.id }}', '{{ v5.id }}', '{{ v6.id }}'
      ];

      if (variants.some(function(v) { return !v || v === ''; })) {
        alert('Bundle configuration error — one or more products could not be found.');
        return;
      }

      document.querySelectorAll('#nav-btn, #hero-btn, #cta-bottom-btn, #sticky-btn').forEach(function(btn) {
        btn.textContent = 'Processing…';
        btn.disabled = true;
      });

      var items = variants.map(function(id) { return { id: Number(id), quantity: 1 }; });

      fetch('/cart/clear.js', { method: 'POST' })
        .then(function() {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: items })
          });
        })
        .then(function(res) { return res.json(); })
        .then(function() { window.location.href = '/checkout'; })
        .catch(function(err) {
          console.error('Bundle checkout error:', err);
          alert('There was an error. Please try again.');
